# Port the server listens on. Bind is 0.0.0.0 so it's reachable from other devices on your LAN.
PORT=4000

# Free API key from https://api-ninjas.com/api/motorcycles (sign up, then copy your key here).
# Without this, model search will return an empty list but the rest of the app still works.
API_NINJAS_KEY=

# Optional: override where the sqlite db + uploaded diagrams are stored.
# DATA_DIR=/absolute/path/to/data
